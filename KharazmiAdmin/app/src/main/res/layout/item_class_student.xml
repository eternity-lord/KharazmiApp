<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_small"
    app:cardCornerRadius="@dimen/spacing_small"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/gold_bg_elevated"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_normal"
        android:layoutDirection="rtl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_small">

            <TextView
                android:id="@+id/tvStudentName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="علی محمدی"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="16sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tvStudentStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="تسویه شده"
                android:textColor="@color/status_success"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="@drawable/border_bg"
                android:layout_marginStart="@dimen/spacing_small"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvStudentMobile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="شناسه: 123"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:fontFeatureSettings="tnum"
        android:id="@+id/tvStudentPaid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="✅ پرداخت: 1,500,000 تومان"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:fontFeatureSettings="tnum"
        android:id="@+id/tvStudentDebt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="🔴 بدهی: 500,000 تومان"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="end"/>
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
