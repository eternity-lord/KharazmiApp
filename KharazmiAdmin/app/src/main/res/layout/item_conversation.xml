<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/GajCardViewStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_small"
    app:cardCornerRadius="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_normal"
        android:layoutDirection="rtl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvConvTitle"
                android:text="سید محمد موسوی"
                android:textStyle="bold"
                android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                android:textColor="?attr/colorOnSurface"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>

            <!-- Pin icon -->
            <ImageView
                android:id="@+id/imgPinned"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/btn_star_big_on"
                app:tint="?attr/colorSecondary"
                android:layout_marginLeft="6dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvConvTime"
                android:text="۱۶:۳۰"
                android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                android:fontFeatureSettings="tnum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvConvLastMessage"
            android:text="پیام پیش‌نمایش در صندوق ورودی..."
            android:textAppearance="@style/TextAppearance.Kharazmi.Body"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
