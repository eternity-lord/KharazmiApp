<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/gold_border_subtle"
    app:strokeWidth="0.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:layoutDirection="rtl">

        <!-- ردیف اول: عنوان کلاس + مبلغ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvInstallmentCourse"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📘 ریاضی کنکور"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:ellipsize="end"
                android:maxLines="2" />

            <TextView
                android:id="@+id/tvInstallmentAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="۵۰۰,۰۰۰ تومان"
                android:textStyle="bold"
                android:textColor="@color/gold_primary"
                android:textSize="13sp"
                android:fontFeatureSettings="tnum" />
        </LinearLayout>

        <!-- ردیف دوم: سررسید + وضعیت -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvInstallmentDue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📅 سررسید: ۱۴۰۳/۰۶/۲۲"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:fontFeatureSettings="tnum" />

            <TextView
                android:id="@+id/tvInstallmentStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_background"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="⏳ پرداخت نشده"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- تاریخ پرداخت (فقط برای پرداخت‌شده) -->
        <TextView
            android:id="@+id/tvInstallmentPaidAt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="✅ تاریخ پرداخت: ۱۴۰۳/۰۶/۲۲"
            android:textSize="11sp"
            android:textColor="?android:attr/textColorSecondary"
            android:fontFeatureSettings="tnum"
            android:visibility="gone" />

        <!-- دکمه‌های عملیاتی: پرداخت + یادآوری (فقط برای اقساط unpaid) -->
        <LinearLayout
            android:id="@+id/layoutInstallmentActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="end"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInstallmentRemind"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:text="@string/installment_remind"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/gold_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInstallmentPay"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/installment_pay"
                android:textSize="12sp"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
