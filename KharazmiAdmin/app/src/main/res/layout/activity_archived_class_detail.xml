<?xml version="1.0" encoding="utf-8"?>
<!-- گزارش کامل یک کلاس حذف‌شده (صفحهٔ کامل با ظاهر پاپ‌آپ: سرصفحهٔ گرد، کارت‌های آماری، دکمه‌های ثابت پایین) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:background="@color/ds_bg_base">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scrollArchivedDetail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/spacing_large">

                <!-- Hero -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_archive_hero"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_normal"
                    android:paddingEnd="@dimen/spacing_normal"
                    android:paddingTop="@dimen/spacing_small"
                    android:paddingBottom="@dimen/spacing_large">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnArchivedDetailBack"
                        style="@style/Widget.Kharazmi.DS.Button.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/arch_back"
                        android:textColor="@color/archive_hero_text_dim" />

                    <TextView
                        android:id="@+id/tvDetailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:text="@string/arch_loading"
                        android:textColor="@color/archive_hero_text"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetailTeacher"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:textColor="@color/archive_hero_text_dim"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvDetailCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_archive_hero_pill"
                            android:paddingStart="@dimen/spacing_normal"
                            android:paddingEnd="@dimen/spacing_normal"
                            android:paddingTop="@dimen/spacing_tiny"
                            android:paddingBottom="@dimen/spacing_tiny"
                            android:textColor="@color/archive_hero_text"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvDetailDeleted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_small"
                            android:background="@drawable/bg_archive_hero_pill"
                            android:paddingStart="@dimen/spacing_normal"
                            android:paddingEnd="@dimen/spacing_normal"
                            android:paddingTop="@dimen/spacing_tiny"
                            android:paddingBottom="@dimen/spacing_tiny"
                            android:textColor="@color/archive_hero_gold"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressArchivedDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_large" />

                <!-- محتوای اصلی؛ بعد از دریافت داده نمایان می‌شود -->
                <LinearLayout
                    android:id="@+id/llArchivedBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_normal"
                    android:paddingEnd="@dimen/spacing_normal"
                    android:paddingTop="@dimen/spacing_normal"
                    android:visibility="gone">

                    <!-- نمای کلی -->
                    <LinearLayout
                        android:id="@+id/rowOverview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                    <!-- حضور و غیاب -->
                    <TextView
                        style="@style/Widget.Kharazmi.DS.SectionHeader"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="@string/arch_s_attendance"
                        android:textColor="@color/ds_accent" />

                    <LinearLayout
                        android:id="@+id/rowAttendance1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:id="@+id/rowAttendance2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                    <ProgressBar
                        android:id="@+id/pbAttendanceRate"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_tiny"
                        android:layout_marginEnd="@dimen/spacing_tiny"
                        android:max="100"
                        android:progress="0" />

                    <TextView
                        android:id="@+id/tvAttendanceNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:textAppearance="@style/TextAppearance.Kharazmi.DS.Caption" />

                    <!-- مالی -->
                    <TextView
                        style="@style/Widget.Kharazmi.DS.SectionHeader"
                        android:layout_marginTop="@dimen/spacing_normal"
                        android:text="@string/arch_s_finance"
                        android:textColor="@color/ds_accent" />

                    <LinearLayout
                        android:id="@+id/rowFinance1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:id="@+id/rowFinance2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                    <TextView
                        android:id="@+id/tvFinanceNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Kharazmi.DS.Caption" />

                    <!-- اطلاعات کلاس -->
                    <TextView
                        style="@style/Widget.Kharazmi.DS.SectionHeader"
                        android:layout_marginTop="@dimen/spacing_normal"
                        android:text="@string/arch_s_info"
                        android:textColor="@color/ds_accent" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Kharazmi.DS.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tvDetailInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="8dp"
                            android:padding="@dimen/spacing_normal"
                            android:textAppearance="@style/TextAppearance.Kharazmi.DS.Body" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- دانش‌آموزان: اول تعداد (در عنوان)، بعد فهرست -->
                    <TextView
                        android:id="@+id/tvStudentsHeader"
                        style="@style/Widget.Kharazmi.DS.SectionHeader"
                        android:layout_marginTop="@dimen/spacing_normal"
                        android:textColor="@color/ds_accent" />

                    <LinearLayout
                        android:id="@+id/llArchivedStudents"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- تاریخچهٔ جلسات -->
                    <TextView
                        android:id="@+id/tvSessionsHeader"
                        style="@style/Widget.Kharazmi.DS.SectionHeader"
                        android:layout_marginTop="@dimen/spacing_normal"
                        android:text="@string/arch_s_sessions"
                        android:textColor="@color/ds_accent" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Kharazmi.DS.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/llArchivedSessions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_normal" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- نوار دکمه‌های ثابت پایین -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ds_bg_surface"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_small">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnArchivedShare"
            style="@style/Widget.Kharazmi.DS.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_tiny"
            android:layout_weight="1"
            android:text="@string/arch_btn_share"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnArchivedRestore"
            style="@style/Widget.Kharazmi.DS.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_tiny"
            android:layout_weight="1"
            android:text="@string/main_trash_restore"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
