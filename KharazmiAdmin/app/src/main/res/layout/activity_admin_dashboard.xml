<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@color/gold_bg_base">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gold_primary"
        app:elevation="4dp">

        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">

            <TextView
                android:id="@+id/tvDashboardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_title"
                android:textColor="?attr/colorOnPrimary"
                android:textAppearance="@style/TextAppearance.Kharazmi.PageTitle" />
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeDashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp">

                <!-- Top controls -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDashboardRefresh"
                        style="@style/Widget.Kharazmi.Button.Gold"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_refresh"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDashboardBack"
                        style="@style/Widget.Kharazmi.Button.Gold.Outline"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/action_back"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressDashboard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvDashboardEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:gravity="center"
                    android:text="@string/dashboard_loading"
                    android:textAppearance="@style/TextAppearance.Kharazmi.Body"
                    android:visibility="gone" />

                <!-- KPI Grid 2x2 -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="2"
                    android:useDefaultMargins="true"
                    android:alignmentMode="alignMargins"
                    android:layout_marginTop="8dp">

                    <!-- 💰 درآمد امروز -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardKpiRevenue"
                        style="@style/Widget.Kharazmi.Card.Gold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1"
                        android:layout_margin="4dp"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="#4CAF50"
                        app:strokeWidth="1.5dp"
                        app:cardBackgroundColor="@color/gold_bg_elevated">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💰"
                                android:textSize="22sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_today_revenue"
                                android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                                android:textColor="@color/gold_primary"
                                android:layout_marginTop="4dp"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/tvKpiRevenueValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                                android:textColor="#4CAF50"
                                android:layout_marginTop="6dp"
                                android:fontFeatureSettings="tnum"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvKpiRevenueSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_today_revenue_sub"
                                android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                                android:textColor="@color/text_secondary"
                                android:gravity="center"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ⚠️ معوقات -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardKpiOverdue"
                        style="@style/Widget.Kharazmi.Card.Gold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1"
                        android:layout_margin="4dp"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="#F44336"
                        app:strokeWidth="1.5dp"
                        app:cardBackgroundColor="@color/gold_bg_elevated">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⚠️"
                                android:textSize="22sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_overdue"
                                android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                                android:textColor="@color/gold_primary"
                                android:layout_marginTop="4dp"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/tvKpiOverdueAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                                android:textColor="#F44336"
                                android:layout_marginTop="6dp"
                                android:fontFeatureSettings="tnum"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvKpiOverdueSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                                android:textColor="@color/text_secondary"
                                android:gravity="center"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 👨‍🎓 دانش‌آموزان فعال -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardKpiStudents"
                        style="@style/Widget.Kharazmi.Card.Gold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1"
                        android:layout_margin="4dp"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="#2196F3"
                        app:strokeWidth="1.5dp"
                        app:cardBackgroundColor="@color/gold_bg_elevated">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="👨‍🎓"
                                android:textSize="22sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_active_students"
                                android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                                android:textColor="@color/gold_primary"
                                android:layout_marginTop="4dp"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/tvKpiStudentsValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                                android:textColor="#2196F3"
                                android:layout_marginTop="6dp"
                                android:fontFeatureSettings="tnum"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvKpiStudentsSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_students_sub"
                                android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                                android:textColor="@color/text_secondary"
                                android:gravity="center"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 🚨 هشدارهای رادار -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardKpiAlerts"
                        style="@style/Widget.Kharazmi.Card.Gold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1"
                        android:layout_margin="4dp"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="#FF9800"
                        app:strokeWidth="1.5dp"
                        app:cardBackgroundColor="@color/gold_bg_elevated">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🚨"
                                android:textSize="22sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_radar_alerts"
                                android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                                android:textColor="@color/gold_primary"
                                android:layout_marginTop="4dp"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/tvKpiAlertsValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                                android:textColor="#FF9800"
                                android:layout_marginTop="6dp"
                                android:fontFeatureSettings="tnum"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvKpiAlertsSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_alerts_sub"
                                android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                                android:textColor="@color/text_secondary"
                                android:gravity="center"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </GridLayout>

                <!-- اقدامات سریع -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Kharazmi.Card.Gold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/gold_border_subtle">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_quick_actions"
                            android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                            android:textColor="@color/gold_primary" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="10dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDashboardDunning"
                                style="@style/Widget.Kharazmi.Button.Gold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_action_dunning"
                                app:icon="@android:drawable/ic_menu_send"
                                app:iconGravity="textStart" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDashboardAudit"
                                style="@style/Widget.Kharazmi.Button.Gold.Outline"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/dashboard_action_audit"
                                app:icon="@android:drawable/ic_menu_search"
                                app:iconGravity="textStart" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDashboardDebtors"
                                style="@style/Widget.Kharazmi.Button.Gold.Outline"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/dashboard_action_debtors"
                                app:icon="@android:drawable/ic_menu_sort_by_size"
                                app:iconGravity="textStart" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Export to Excel/CSV (Admin only) — سه خروجی سرور (/exports/*) -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Kharazmi.Card.Gold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/gold_border_subtle">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/export_card_title"
                            android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                            android:textColor="@color/gold_primary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/export_card_subtitle"
                            android:textColor="@color/gold_primary_light"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="10dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnExportDebtors"
                                style="@style/Widget.Kharazmi.Button.Gold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/export_debtors"
                                app:icon="@android:drawable/ic_menu_sort_by_size"
                                app:iconGravity="textStart" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnExportOverdue"
                                style="@style/Widget.Kharazmi.Button.Gold.Outline"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/export_overdue"
                                app:icon="@android:drawable/ic_menu_my_calendar"
                                app:iconGravity="textStart" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnExportAlerts"
                                style="@style/Widget.Kharazmi.Button.Gold.Outline"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/export_alerts"
                                app:icon="@android:drawable/ic_menu_search"
                                app:iconGravity="textStart" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Bottom: Top 5 Critical -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Kharazmi.Card.Gold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/gold_border_subtle">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_critical_title"
                            android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                            android:textColor="@color/gold_primary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_critical_subtitle"
                            android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/tvDashboardCriticalEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp"
                            android:gravity="center"
                            android:text="@string/dashboard_critical_empty"
                            android:textAppearance="@style/TextAppearance.Kharazmi.Body"
                            android:visibility="gone" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvDashboardCritical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="8dp"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
