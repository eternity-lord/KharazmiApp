<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gold_bg_base"
    android:layoutDirection="rtl">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gold_primary"
        app:elevation="@dimen/elevation_appbar">

        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">

            <TextView
                android:id="@+id/tvLiveTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="کلاس زنده"
                android:textColor="?attr/colorOnPrimary"
                android:textAppearance="@style/TextAppearance.Kharazmi.PageTitle" />
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_normal">

            <!-- 🔴 در حال برگزاری — تایمر -->
            <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Kharazmi.Card.Gold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/gold_primary"
                app:strokeWidth="1dp"
                android:layout_marginBottom="@dimen/spacing_normal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_normal"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvLiveIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔴 در حال برگزاری — ۰ دقیقه گذشته"
                        android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                        android:textColor="#C62828"
                        android:textStyle="bold"
                        android:fontFeatureSettings="tnum" />

                    <TextView
                        android:id="@+id/tvLiveStartedAt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="شروع: --:--"
                        android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:text="لیست لحظه‌ای حضور و غیاب"
                android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                android:textColor="@color/gold_primary"
                android:layout_marginHorizontal="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="تغییرات به‌صورت فوری در UI اعمال و سپس به سرور همگام می‌شود."
                android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                android:layout_marginHorizontal="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- List of students -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLiveStudents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_normal"
        android:background="@color/gold_bg_elevated"
        android:elevation="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEndLive"
            style="@style/Widget.Kharazmi.Button.Gold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="پایان کلاس و محاسبه شهریه"
            app:backgroundTint="@color/status_danger"
            app:icon="@drawable/ic_save_24"
            app:iconGravity="textStart"
            app:elevation="@dimen/elevation_button" />
    </LinearLayout>

</LinearLayout>
