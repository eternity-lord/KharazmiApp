<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gold_bg_base"
    android:layoutDirection="rtl">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gold_primary"
        app:elevation="@dimen/elevation_appbar">

        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">

            <TextView
                android:id="@+id/tvRosterTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="جزئیات زنده کلاس"
                android:textColor="?attr/colorOnPrimary"
                android:textAppearance="@style/TextAppearance.Kharazmi.PageTitle" />
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Kharazmi.Card.Gold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="18dp"
        app:strokeColor="@color/status_danger"
        app:strokeWidth="1dp"
        android:layout_margin="@dimen/spacing_small">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_normal">

            <TextView
                android:id="@+id/tvRosterClassInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="کلاس: ریاضی | معلم: علی مرادی"
                android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRosterElapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱ ۰ دقیقه گذشته"
                android:textAppearance="@style/TextAppearance.Kharazmi.Body"
                android:textColor="@color/status_danger"
                android:fontFeatureSettings="tnum"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvRosterSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 حاضر: 0 | 🔴 غایب: 0 | ⚪ نامشخص: 0"
                android:textAppearance="@style/TextAppearance.Kharazmi.Body"
                android:textColor="@color/text_primary"
                android:fontFeatureSettings="tnum"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvRosterEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="دانش‌آموزی ثبت‌نام نشده است."
        android:textAppearance="@style/TextAppearance.Kharazmi.Body"
        android:textColor="?android:attr/textColorSecondary"
        android:gravity="center"
        android:padding="@dimen/spacing_large"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRoster"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="@dimen/spacing_normal" />
</LinearLayout>
