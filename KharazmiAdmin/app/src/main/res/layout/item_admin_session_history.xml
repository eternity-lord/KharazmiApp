<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
        <TextView android:id="@+id/tvSessionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" />
        <TextView android:id="@+id/tvProblemFlags" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#C62828" />
        <Button android:id="@+id/btnReopenSession" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="بازگشایی برای اصلاح" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
