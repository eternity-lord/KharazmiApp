<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gold_bg_base"
    android:layoutDirection="rtl"
>

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gold_primary"
        app:elevation="@dimen/elevation_appbar"
    >
        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
        >
            <TextView
                android:id="@+id/tvPageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="برگزاری جلسه جدید"
                android:textColor="?attr/colorOnPrimary"
                android:textAppearance="@style/TextAppearance.Kharazmi.PageTitle"
            />
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Offline status indicator -->
    <TextView
        android:id="@+id/tvNetworkStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🟢 وضعیت: آنلاین (SYNCED)"
        android:textColor="#ffffff"
        android:background="#2E7D32"
        android:padding="8dp"
        android:gravity="center"
        android:fontFeatureSettings="tnum"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- C10-B3: offline queue status card (visible only when items are queued) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardQueueStatus"
        style="@style/Widget.Kharazmi.Card.Gold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:strokeColor="@color/gold_primary"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvQueueTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📤 صف ارسال آفلاین"
                android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                android:textColor="@color/gold_primary" />

            <LinearLayout
                android:id="@+id/llQueueItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
    >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_normal"
        >

            <!-- Session Time Card wrapper -->
            <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Kharazmi.Card.Gold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                android:layout_marginBottom="@dimen/spacing_normal"
                app:strokeColor="@color/gold_primary"
                app:strokeWidth="1dp"
            >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_normal"
                >

                    <TextView
                        android:text="تنظیمات زمان جلسه"
                        android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                        android:textColor="@color/gold_primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                    />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/spacing_normal"
                    >

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Kharazmi.Input.Gold"
                            android:layout_width="0dp"
                            android:layout_weight="1.2"
                            android:layout_height="wrap_content"
                            android:hint="تاریخ امروز"
                        >
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etSessionDate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:focusable="false"
                                android:fontFeatureSettings="tnum"
                                android:textColor="@color/text_primary"
                            />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- FIX (audit-v2/#13): etSessionTime حذف شد — ورودی مرده بود (هرگز خوانده نمی‌شد و دیتای کاربر را دور می‌ریخت) -->
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:text="لیست حضور و غیاب دانش‌آموزان"
                android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                android:textColor="@color/gold_primary"
                android:layout_marginHorizontal="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
            />

            <!-- List of students in class -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAttendanceList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layoutAnimation="@anim/layout_animation_fall_down"/>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action panel: styled using central style Widget.Kharazmi.Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_normal"
        android:background="@color/gold_bg_elevated"
        android:elevation="10dp"
    >

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinishSession"
            style="@style/Widget.Kharazmi.Button.Gold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="پایان جلسه و محاسبه شهریه"
            app:backgroundTint="@color/gold_primary"
            app:icon="@drawable/ic_save_24"
            app:iconGravity="textStart"
            app:elevation="@dimen/elevation_button"
        />
    </LinearLayout>

</LinearLayout>
