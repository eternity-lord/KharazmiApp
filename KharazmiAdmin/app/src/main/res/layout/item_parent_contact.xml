<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_normal"
        android:gravity="center_vertical"
        android:layoutDirection="rtl">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStudentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="نام دانش‌آموز"
                android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvClasses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="کلاس‌ها: ریاضی، فیزیک"
                android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvParentPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱 ولی: 09123456789"
                android:textAppearance="@style/TextAppearance.Kharazmi.Body"
                android:textColor="@color/gold_primary"
                android:layout_marginTop="6dp"
                android:fontFeatureSettings="tnum"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStudentPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱 دانش‌آموز: 09121111111"
                android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                android:textColor="?android:attr/textColorSecondary"
                android:fontFeatureSettings="tnum"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Touch-friendly operation buttons: precisely 48dp according to accessibility standards -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/gold_primary"
                app:cardBackgroundColor="@color/gold_bg_elevated">

                <ImageButton
                    android:id="@+id/btnSmsParent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/sym_action_email"
                    app:tint="@color/gold_primary"
                    android:contentDescription="ارسال پیامک"
                    android:padding="12dp" />
            </com.google.android.material.card.MaterialCardView>

            <android.widget.Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/gold_primary"
                app:cardBackgroundColor="@color/gold_bg_elevated">

                <ImageButton
                    android:id="@+id/btnCallParent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_call_24"
                    app:tint="@color/gold_primary"
                    android:contentDescription="تماس تلفنی"
                    android:padding="12dp" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
