<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gold_bg_base"
    android:layoutDirection="rtl">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gold_primary"
        app:elevation="@dimen/elevation_appbar"
    >
        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">
            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="لیست کاربران"
                android:textColor="?attr/colorOnPrimary"
                android:textAppearance="@style/TextAppearance.Kharazmi.PageTitle"/>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Search Card Wrapper -->
    <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Kharazmi.Card.Gold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_normal"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_normal"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Kharazmi.Input.Gold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="جستجو (نام یا کدملی)"
                app:startIconDrawable="@drawable/ic_search_24"
                app:startIconTint="@color/gold_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- خروجی Excel و PDF مخصوص معلمان -->
    <LinearLayout
        android:id="@+id/llPersonExportContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_normal"
        android:layout_marginBottom="4dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPersonExportExcel"
            style="@style/Widget.Kharazmi.Button.Gold.Outline"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="خروجی Excel"
            android:textColor="@color/gold_primary"
            app:strokeColor="@color/gold_primary"
            android:layout_marginEnd="6dp"
            app:cornerRadius="24dp"
            android:paddingVertical="10dp"
            app:icon="@drawable/ic_save_24"
            app:iconTint="@color/gold_primary"
            app:iconGravity="textStart"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPersonExportPdf"
            style="@style/Widget.Kharazmi.Button.Gold.Outline"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="چاپ PDF"
            android:textColor="@color/gold_primary"
            app:strokeColor="@color/gold_primary"
            android:layout_marginStart="6dp"
            app:cornerRadius="24dp"
            android:paddingVertical="10dp"
            app:icon="@drawable/ic_print"
            app:iconTint="@color/gold_primary"
            app:iconGravity="textStart"/>
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/spacing_small"
            android:clipToPadding="false" 
            android:layoutAnimation="@anim/layout_animation_fall_down"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
