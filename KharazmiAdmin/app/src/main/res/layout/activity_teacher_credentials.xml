<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gold_bg_base"
    android:layoutDirection="rtl">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gold_primary"
        app:elevation="@dimen/elevation_appbar"
    >
        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مدیریت هویت معلمان"
                android:textColor="?attr/colorOnPrimary"
                android:textAppearance="@style/TextAppearance.Kharazmi.PageTitle"/>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_normal">

            <!-- Search Card -->
            <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Kharazmi.Card.Gold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_normal"
                app:cardCornerRadius="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_normal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="جستجو و انتخاب مربی"
                        android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                        android:textColor="@color/gold_primary"
                        android:layout_marginBottom="@dimen/spacing_small"/>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Kharazmi.Input.Gold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="نام، نام‌خانوادگی یا کدملی مربی..."
                        app:startIconDrawable="@drawable/ic_search_24">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSearchTeacher"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvTeacherResults"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxHeight="200dp"
                        android:visibility="gone"
                        android:background="@color/gold_bg_elevated"
                        android:layout_marginTop="4dp"
                        android:layoutAnimation="@anim/layout_animation_fall_down"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Teacher Details and Credentials Form (Hidden by default) -->
            <LinearLayout
                android:id="@+id/llCredentialsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Details Card -->
                <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Kharazmi.Card.Gold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_normal"
                    app:cardCornerRadius="20dp"
                    app:strokeColor="@color/gold_primary"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_normal">

                        <TextView
                            android:id="@+id/tvTeacherName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="سید محمد موسوی"
                            android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/tvTeacherCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="کد ثبت مربی: ۱۲۳"
                            android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                            android:textColor="@color/text_primary"
                            android:fontFeatureSettings="tnum"
                            android:layout_marginBottom="@dimen/spacing_normal"/>

                        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/gold_border_subtle" android:layout_marginBottom="@dimen/spacing_normal" />

                        <!-- Form inputs for inline quick edit -->
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Kharazmi.Input.Gold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="شماره همراه معلم">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTeacherMobile"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="phone"
                                android:fontFeatureSettings="tnum"
                                android:maxLength="11"
                                android:textColor="@color/text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Kharazmi.Input.Gold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_normal"
                            android:hint="شماره کارت بانکی">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTeacherCardNumber"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:fontFeatureSettings="tnum"
                                android:maxLength="16"
                                android:textColor="@color/text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <Space android:layout_width="match_parent" android:layout_height="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSaveCredentials"
                            style="@style/Widget.Kharazmi.Button.Gold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ثبت تغییرات تماس و بانک"
                            app:backgroundTint="@color/gold_primary"
                            app:icon="@drawable/ic_save_24"
                            app:iconGravity="textStart"
                            app:elevation="@dimen/elevation_button" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Security reset card -->
                <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Kharazmi.Card.Gold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:strokeColor="?attr/colorError"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="@dimen/spacing_normal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_normal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="کنترل دسترسی و کلمه عبور"
                            android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                            android:textColor="?attr/colorError"
                            android:layout_marginBottom="@dimen/spacing_small"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="کلمه عبور مربی به صورت رمزنگاری‌نشده در این کادر نشان داده می‌شود. در صورت فراموشی یا نیاز به صدور رمز جدید، دکمه زیر را کلیک کنید."
                            android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="@dimen/spacing_normal"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="@dimen/spacing_normal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="رمز عبور فعلی:"
                                android:textAppearance="@style/TextAppearance.Kharazmi.Body"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"/>

                            <Space android:layout_width="12dp" android:layout_height="wrap_content"/>

                            <TextView
                                android:id="@+id/tvCurrentPassword"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="---"
                                android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                                android:textColor="?attr/colorError"
                                android:fontFeatureSettings="tnum"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnResetPassword"
                            style="@style/Widget.Kharazmi.Button.Gold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="صدور رمز جدید برای این معلم"
                            app:backgroundTint="?attr/colorError"
                            app:icon="@android:drawable/ic_lock_lock"
                            app:iconTint="?attr/colorOnError"
                            app:iconGravity="textStart"
                            app:elevation="@dimen/elevation_button" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
