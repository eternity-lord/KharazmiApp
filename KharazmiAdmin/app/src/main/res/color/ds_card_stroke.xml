<?xml version="1.0" encoding="utf-8"?>
<!-- DESIGN SYSTEM: مرز کارت — default / focused / pressed / disabled -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/ds_border" />
    <item android:state_pressed="true" android:color="@color/ds_accent" />
    <item android:state_focused="true" android:color="@color/ds_accent" />
    <item android:color="@color/ds_border" />
</selector>
