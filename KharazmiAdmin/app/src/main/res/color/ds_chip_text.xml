<?xml version="1.0" encoding="utf-8"?>
<!-- DESIGN SYSTEM: متن چیپ — checked/selected/disabled -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/ds_text_disabled" />
    <item android:state_checked="true" android:color="@color/ds_on_accent" />
    <item android:state_selected="true" android:color="@color/ds_on_accent" />
    <item android:color="@color/ds_text_secondary" />
</selector>
