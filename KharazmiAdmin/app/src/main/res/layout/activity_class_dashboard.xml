<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gold_bg_base"
    android:layoutDirection="rtl"
>

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gold_primary"
        app:elevation="@dimen/elevation_appbar"
    >
        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
        >
            <TextView
                android:id="@+id/tvClassName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مدیریت کلاس ..."
                android:textColor="?attr/colorOnPrimary"
                android:textAppearance="@style/TextAppearance.Kharazmi.PageTitle"
            />
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
    >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_normal"
        >

            <!-- Class Status Card (Theme compatible and elegant) -->
            <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Kharazmi.Card.Gold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_normal"
                app:cardCornerRadius="18dp"
                app:strokeColor="@color/gold_primary"
                app:strokeWidth="1dp"
            >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_normal"
                >

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="وضعیت کلاس:  فعال ✅"
                        android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                    />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/tvSessionPrice"
                        android:text="تعرفه هر جلسه: ..."
                        android:textAppearance="@style/TextAppearance.Kharazmi.Body"
                        android:textColor="@color/text_primary"
                        android:alpha="0.8"
                        android:fontFeatureSettings="tnum"
                        android:layout_marginTop="6dp"
                    />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4 Actions Grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
            >

                <!-- 1. Start New Session -->
                <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnNewSession"
                    style="@style/Widget.Kharazmi.Card.Gold"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="18dp"
                    android:clickable="true"
                    android:focusable="true"
                >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_normal"
                    >
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_history_24"
                            app:tint="@color/gold_primary"
                        />
                        <TextView
                            android:text="شروع جلسه جدید\n(حضور و غیاب)"
                            android:textAlignment="center"
                            android:textAppearance="@style/TextAppearance.Kharazmi.Body"
                            android:textStyle="bold"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/text_primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                        />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Session History -->
                <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnSessionHistory"
                    style="@style/Widget.Kharazmi.Card.Gold"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="18dp"
                    android:clickable="true"
                    android:focusable="true"
                >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_normal"
                    >
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_history_24"
                            app:tint="@color/gold_primary"
                        />
                        <TextView
                            android:text="تاریخچه جلسات\nبرگزار شده"
                            android:textAlignment="center"
                            android:textAppearance="@style/TextAppearance.Kharazmi.Body"
                            android:textStyle="bold"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/text_primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                        />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Student List -->
                <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnStudentList"
                    style="@style/Widget.Kharazmi.Card.Gold"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="18dp"
                    android:clickable="true"
                    android:focusable="true"
                >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_normal"
                    >
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_calendar_24"
                            app:tint="@color/gold_primary"
                        />
                        <TextView
                            android:text="لیست دانش‌آموزان\nو پروفایل"
                            android:textAlignment="center"
                            android:textAppearance="@style/TextAppearance.Kharazmi.Body"
                            android:textStyle="bold"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/text_primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                        />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Financial Share -->
                <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnFinancial"
                    style="@style/Widget.Kharazmi.Card.Gold"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    app:cardCornerRadius="18dp"
                    android:clickable="true"
                    android:focusable="true"
                >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_normal"
                    >
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_group"
                            app:tint="@color/gold_primary"
                        />
                        <TextView
                            android:text="گزارش مالی\n(سهم معلم)"
                            android:textAlignment="center"
                            android:textAppearance="@style/TextAppearance.Kharazmi.Body"
                            android:textStyle="bold"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/text_primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                        />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
