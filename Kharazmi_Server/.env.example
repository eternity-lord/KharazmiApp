# کپی این فایل به عنوان .env و وارد کردن پسورد اختصاصی آموزشگاه خودتان
DATABASE_URL=postgresql://username:password@localhost:port/database_name
# کلید امضای توکن‌ها: یک رشته‌ی هگز ۶۴کاراکتری تصادفی بگذارید (ساخت: python3 -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=put-a-random-64-char-hex-here
# درگاه پرداخت آنلاین: تا اتصال درگاه واقعی بانکی false بماند (کال‌بک و صفحه شبیه‌ساز 404 می‌دهند)
PAYMENT_GATEWAY_ENABLED=false
# محیط اجرا: فقط production مستندات تعاملی (/docs و /openapi.json) را خاموش می‌کند (M2)
# ENV=development
# دامنه‌های مجاز CORS با کاما (پیش‌فرض خالی = هیچ مبدا خارجی؛ اپ موبایل و پورتال same-origin نیازی ندارند) (M1)
# CORS_ALLOWED_ORIGINS=
