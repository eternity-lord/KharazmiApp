<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gold_bg_base"
    android:layoutDirection="rtl"
>

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gold_primary"
        app:elevation="@dimen/elevation_appbar"
    >
        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
        >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="پنل پیامک خوارزمی"
                android:textColor="?attr/colorOnPrimary"
                android:textAppearance="@style/TextAppearance.Kharazmi.PageTitle"
            />
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Tab Layout for visual/UX separation (Clean and Uncluttered) -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutSms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gold_bg_elevated"
        app:tabSelectedTextColor="@color/gold_primary"
        app:tabIndicatorColor="@color/gold_primary"
        app:tabMode="fixed"
        app:tabGravity="fill">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ارسال پیامک جدید"/>

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تاریخچه پیامک‌ها"/>
    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/spacing_normal">

        <!-- Container 1: Sending New SMS -->
        <ScrollView
            android:id="@+id/llSendSmsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Kharazmi.Card.Gold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    android:layout_marginBottom="@dimen/spacing_normal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_normal">

                        <TextView
                            android:text="ارسال پیام جدید"
                            android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                            android:textColor="@color/gold_primary"
                            android:layout_marginBottom="@dimen/spacing_normal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                        />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:boxStrokeColor="@color/gold_primary"
                            app:hintTextColor="@color/gold_primary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="گیرندگان"
                            app:startIconDrawable="@drawable/ic_group"
                        >
                            <AutoCompleteTextView
                                android:id="@+id/acTarget"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:text="همه دانش‌آموزان"
                                android:textColor="@color/text_primary"
                            />
                        </com.google.android.material.textfield.TextInputLayout>

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="12dp"
                        />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Kharazmi.Input.Gold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="متن پیامک"
                        >
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etMessage"
                                android:layout_width="match_parent"
                                android:layout_height="140dp"
                                android:gravity="top|right"
                                android:textColor="@color/text_primary"
                            />
                        </com.google.android.material.textfield.TextInputLayout>

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="16dp"
                        />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSendSms"
                            style="@style/Widget.Kharazmi.Button.Gold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ارسال پیامک"
                            app:backgroundTint="@color/gold_primary"
                            app:icon="@drawable/ic_arrow_forward_24"
                            app:iconGravity="textStart"
                            app:elevation="@dimen/elevation_button"
                        />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <!-- Container 2: SMS History -->
        <LinearLayout
            android:id="@+id/llHistorySmsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:text="تاریخچه ارسال‌ها"
                android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                android:textColor="@color/gold_primary"
                android:layout_marginHorizontal="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
            />

            <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Kharazmi.Card.Gold"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="20dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSmsHistory"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/spacing_small"
                    android:layoutAnimation="@anim/layout_animation_fall_down"/>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
