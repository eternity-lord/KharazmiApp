<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gold_bg_base"
    android:layoutDirection="rtl">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gold_primary"
        app:elevation="@dimen/elevation_appbar"
    >
        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ثبت نمره جدید"
                android:textColor="?attr/colorOnPrimary"
                android:textAppearance="@style/TextAppearance.Kharazmi.PageTitle"/>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_normal"
            android:gravity="center_horizontal">

            <!-- Student / Course details subtitle -->
            <TextView
                android:id="@+id/tvSubmitGradeHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ثبت نمره کلاسی دانش‌آموز"
                android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                android:textColor="@color/gold_primary"
                android:layout_marginTop="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_normal"/>

            <!-- Form Card Wrapper -->
            <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Kharazmi.Card.Gold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                android:layout_marginBottom="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_normal">

                    <!-- Exam Title -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Kharazmi.Input.Gold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_normal"
                        android:hint="عنوان آزمون (مثال: میان ترم)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etExamTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Score and Max Score Side-by-Side Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/spacing_normal"
                        android:baselineAligned="false">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Kharazmi.Input.Gold"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp"
                            android:hint="نمره دانش‌آموز">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etScore"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:textColor="@color/text_primary"
                                android:fontFeatureSettings="tnum"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Kharazmi.Input.Gold"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="6dp"
                            android:hint="نمره کل (پیش‌فرض 20)">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etMaxScore"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="20"
                                android:inputType="numberDecimal"
                                android:textColor="@color/text_primary"
                                android:fontFeatureSettings="tnum"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Description -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Kharazmi.Input.Gold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="توضیحات (اختیاری)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDesc"
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:gravity="top|right"
                            android:textColor="@color/text_primary"/>
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Submit Button styled with central pill style -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitGradeFinal"
                style="@style/Widget.Kharazmi.Button.Gold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ثبت نمره"
                app:backgroundTint="@color/gold_primary"
                app:icon="@drawable/ic_save_24"
                app:iconGravity="textStart"
                app:elevation="@dimen/elevation_button"
                android:layout_marginHorizontal="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_normal" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
