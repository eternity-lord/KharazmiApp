<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:layoutDirection="rtl"
    android:background="@color/ds_bg_base">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="داشبورد بدهکاران"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/gold_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">
        <EditText
            android:id="@+id/etDebtorsSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="جستجوی دانش‌آموز، معلم یا کلاس"
            android:inputType="text"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDebtorsSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="جستجو" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDebtorsRefresh"
            style="@style/Widget.Kharazmi.Button.Gold.Outline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="تازه‌سازی" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDebtorsExport"
            style="@style/Widget.Kharazmi.Button.Gold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="خروجی بدهکاران" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDebtorsSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/text_primary"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/tvDebtorsBreakdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/text_secondary" />
    <TextView
        android:id="@+id/tvDebtorsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:gravity="center"
        android:textColor="@color/text_secondary" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDebtors"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />
</LinearLayout>
