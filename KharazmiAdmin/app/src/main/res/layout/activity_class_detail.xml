<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gold_bg_base"
    android:layoutDirection="rtl">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gold_primary"
        app:elevation="@dimen/elevation_appbar"
    >
        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">
            <TextView
                android:id="@+id/tvPageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="جزئیات کلاس"
                android:textColor="?attr/colorOnPrimary"
                android:textAppearance="@style/TextAppearance.Kharazmi.PageTitle"/>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutClass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gold_bg_elevated"
        app:tabSelectedTextColor="@color/gold_primary"
        app:tabIndicatorColor="@color/gold_primary">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="اطلاعات کلی" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="لیست دانش‌آموزان" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تاریخچه جلسات" />

    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Tab 1 content: Overview and Grouped operations (Non-flat & Categorized) -->
        <ScrollView
            android:id="@+id/scrollViewContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_normal">

                <!-- Info summary wrapped in Card -->
                <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Kharazmi.Card.Gold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_normal"
                    app:cardCornerRadius="20dp">

                    <TextView
                        android:id="@+id/tvClassContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="در حال دریافت اطلاعات..."
                        android:textAppearance="@style/TextAppearance.Kharazmi.Body"
                        android:lineSpacingExtra="8dp"
                        android:padding="@dimen/spacing_normal"/>
                </com.google.android.material.card.MaterialCardView>

                <!-- Group A: Educational operations -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="امور آموزشی کلاس"
                    android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                    android:textColor="@color/gold_primary"
                    android:layout_marginHorizontal="@dimen/spacing_small"
                    android:layout_marginBottom="@dimen/spacing_small"/>

                <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Kharazmi.Card.Gold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_normal"
                    app:cardCornerRadius="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_normal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGoToAttendance"
                            style="@style/Widget.Kharazmi.Button.Gold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="۱) ثبت حضور و غیاب"
                            app:backgroundTint="@color/gold_primary"
                            app:icon="@drawable/ic_calendar_24"
                            app:iconGravity="textStart"
                            app:elevation="@dimen/elevation_button"
                            android:layout_marginBottom="@dimen/spacing_normal"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClassSetupAction"
                            style="@style/Widget.Kharazmi.Button.Gold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="۲) ثبت‌نام و ویرایش دانش‌آموزان"
                            app:backgroundTint="@color/gold_primary"
                            app:icon="@android:drawable/ic_input_add"
                            app:iconGravity="textStart"
                            app:elevation="@dimen/elevation_button"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Group B: Management and settings operations -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="امور مدیریتی و تنظیمات دوره"
                    android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                    android:textColor="@color/gold_primary"
                    android:layout_marginHorizontal="@dimen/spacing_small"
                    android:layout_marginBottom="@dimen/spacing_small"/>

                <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Kharazmi.Card.Gold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_normal"
                    app:cardCornerRadius="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_normal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEditClassInfoAction"
                            style="@style/Widget.Kharazmi.Button.Gold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="۳) اصلاح اطلاعات کلاس (پایه / عنوان)"
                            app:backgroundTint="@color/gold_primary"
                            android:textColor="@color/white"
                            app:iconTint="@color/white"
                            app:icon="@android:drawable/ic_menu_edit"
                            app:iconGravity="textStart"
                            app:elevation="@dimen/elevation_button"
                            android:layout_marginBottom="@dimen/spacing_normal"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSuspendAction"
                            style="@style/Widget.Kharazmi.Button.Gold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="۴) تعلیق کلاس"
                            app:backgroundTint="@color/gold_primary"
                            android:textColor="@color/white"
                            app:iconTint="@color/white"
                            app:icon="@android:drawable/ic_lock_lock"
                            app:iconGravity="textStart"
                            app:elevation="@dimen/elevation_button"
                            android:layout_marginBottom="@dimen/spacing_normal"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDeleteClassAction"
                            style="@style/Widget.Kharazmi.Button.Gold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="۵) حذف کلاس"
                            app:backgroundTint="?attr/colorError"
                            android:textColor="?attr/colorOnError"
                            app:iconTint="?attr/colorOnError"
                            app:icon="@android:drawable/ic_menu_delete"
                            app:iconGravity="textStart"
                            app:elevation="@dimen/elevation_button"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>

        <!-- Tab 2 & 3 content: Student List & Session History -->
        <LinearLayout
            android:id="@+id/llStudentTabContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/spacing_normal"
            android:visibility="gone">

            <!-- Export Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_small">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClassExportExcel"
                    style="@style/Widget.Kharazmi.Button.Gold.Outline"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="خروجی Excel"
                    android:textColor="@color/gold_primary"
                    app:strokeColor="@color/gold_primary"
                    android:layout_marginEnd="6dp"
                    app:cornerRadius="24dp"
                    android:paddingVertical="10dp"
                    app:icon="@drawable/ic_save_24"
                    app:iconTint="@color/gold_primary"
                    app:iconGravity="textStart"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClassExportPdf"
                    style="@style/Widget.Kharazmi.Button.Gold.Outline"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="چاپ PDF"
                    android:textColor="@color/gold_primary"
                    app:strokeColor="@color/gold_primary"
                    android:layout_marginStart="6dp"
                    app:cornerRadius="24dp"
                    android:paddingVertical="10dp"
                    app:icon="@drawable/ic_print"
                    app:iconTint="@color/gold_primary"
                    app:iconGravity="textStart"/>
            </LinearLayout>

            <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Kharazmi.Card.Gold"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="20dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvStudents"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/spacing_small"
                    android:layoutAnimation="@anim/layout_animation_fall_down"/>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
