    <!-- ==================== GOLD/DARK REDESIGN TOKENS (NEW) ==================== -->
    <!-- Backgrounds - extracted from ED Academy map -->
    <color name="gold_bg_base">#0D0F13</color>          <!-- پس‌زمینه اصلی، مشکی مایل به نیوی -->
    <color name="gold_bg_elevated">#171A21</color>       <!-- کارت‌ها، شیت‌ها -->
    <color name="gold_bg_elevated_2">#1F232C</color>     <!-- کارت روی کارت، دیالوگ -->
    <color name="gold_border_subtle">#2A2F3A</color>     <!-- بوردر ظریف دور کارت‌ها -->

    <!-- Gold accent -->
    <color name="gold_primary">#D4A94C</color>           <!-- طلایی اصلی -->
    <color name="gold_primary_light">#F0C572</color>     <!-- برای گرادینت بالای دکمه -->
    <color name="gold_primary_dark">#A9812F</color>       <!-- برای گرادینت پایین دکمه / حالت pressed -->
    <color name="gold_glow">#33D4A94C</color>              <!-- سایه/گلوی نیمه‌شفاف دور دکمه -->
    <color name="gold_ripple">#66F0C572</color>           <!-- ripple طلایی روشن‌تر alpha 40% -->

    <!-- Text - new palette -->
    <color name="text_primary">#F5F3EE</color>
    <!-- FIX: Readable secondary/disabled Gold text on elevated and disabled surfaces. -->
    <color name="text_secondary">#B5BDCA</color>
    <color name="text_disabled">#9BA4B3</color>
    <color name="text_on_gold">#0D0F13</color>           <!-- متن روی دکمه طلایی همیشه مشکی -->

    <!-- Status (برای اعلان‌ها، حاضری، هشدارها) -->
    <color name="status_success">#4CAF7D</color>
    <color name="status_danger">#E0615A</color>
    <color name="status_info">#5B8DEF</color>
    <color name="status_warning">#D4A94C</color> <!-- هم‌رنگ طلایی -->

    <!-- Gold button states -->
    <color name="gold_button_disabled_bg">#2A2F3A</color>
    <color name="gold_button_disabled_text">@color/text_disabled</color>
    <color name="gold_input_focused">#D4A94C</color>
    <color name="gold_input_error">#E0615A</color>

    <!-- Card states -->
    <color name="gold_card_border_default">#2A2F3A</color>
    <color name="gold_card_border_focused">#D4A94C</color>
    <color name="gold_card_border_error">#E0615A</color>

    <!-- Missing light variants for backward compat -->
    <color name="gold_bg_elevated_variant">#1F232C</color>
    <color name="status_success_light">#1F2A24</color>
    <color name="status_warning_light">#2A251A</color>
    <color name="status_info_light">#1A2130</color>
    <color name="status_danger_light">#2A1E1E</color>

    <!-- FIX: Opaque muted-gold fill keeps sent messages distinct without washing out light text. -->
    <color name="gold_chat_sent_bg">#453821</color>

    <!-- ==================== DESIGN SYSTEM (Phase 1) — SEMANTIC TOKENS ====================
         این بلوک «معنایی» است و توکن‌های تزئینی موجود (gold_*) دست‌نخورده می‌مانند.
         قاعده: رنگ معنایی = وضعیت (موفق/هشدار/خطر/اطلاع/بدهی/اعتبار)، رنگ تزئینی = برند/طلایی.
         هیچ‌کدام از رنگ‌های قدیمی حذف نشده‌اند تا صفحات قدیمی سالم بمانند. -->

    <!-- FIX: item_dunning_draft.xml این رنگ را ارجاع می‌داد ولی هیچ‌جا تعریف نشده بود (خطای resource linking).
         مقدار آن با رنگ سطوح محوِ موجود هم‌خانواده انتخاب شده است. -->
    <color name="gold_bg_subtle">#1A1E26</color>

    <!-- سطوح (از کم‌عمق به عمیق) -->
    <color name="ds_bg_base">@color/gold_bg_base</color>
    <color name="ds_bg_surface">@color/gold_bg_elevated</color>
    <color name="ds_bg_surface_2">@color/gold_bg_elevated_2</color>
    <color name="ds_bg_surface_3">#262B35</color>
    <color name="ds_bg_surface_disabled">@color/gold_button_disabled_bg</color>
    <color name="ds_border">@color/gold_border_subtle</color>
    <color name="ds_border_strong">#3A4150</color>

    <!-- اکسنت برند (طلایی) — محدود و هدفمند -->
    <color name="ds_accent">@color/gold_primary</color>
    <color name="ds_accent_soft">@color/gold_primary_light</color>
    <color name="ds_accent_strong">@color/gold_primary_dark</color>
    <color name="ds_on_accent">@color/text_on_gold</color>

    <!-- متن -->
    <color name="ds_text_primary">@color/text_primary</color>
    <color name="ds_text_secondary">@color/text_secondary</color>
    <color name="ds_text_disabled">@color/text_disabled</color>

    <!-- معنایی: موفق -->
    <color name="ds_success">@color/status_success</color>
    <color name="ds_success_container">@color/status_success_light</color>
    <color name="ds_success_on_container">#8FE0B4</color>

    <!-- معنایی: هشدار -->
    <color name="ds_warning">@color/status_warning</color>
    <color name="ds_warning_container">@color/status_warning_light</color>
    <color name="ds_warning_on_container">#F0C572</color>

    <!-- معنایی: خطر -->
    <color name="ds_danger">@color/status_danger</color>
    <color name="ds_danger_container">@color/status_danger_light</color>
    <color name="ds_danger_on_container">#F2A9A4</color>
    <!-- DESIGN SYSTEM (Phase 2): سطح پرشده خطر — تیره‌تر از ds_danger تا متن سفید کنتراست ≥4.5 بگیرد -->
    <color name="ds_danger_deep">#B03A33</color>
    <color name="ds_danger_deep_pressed">#8E2B25</color>

    <!-- معنایی: اطلاع -->
    <color name="ds_info">@color/status_info</color>
    <color name="ds_info_container">@color/status_info_light</color>
    <color name="ds_info_on_container">#A8C4F5</color>

    <!-- خنثی (برای چیپ/پیل‌های بی‌وضعیت) -->
    <color name="ds_neutral">@color/text_secondary</color>
    <color name="ds_neutral_container">@color/ds_bg_surface_3</color>

    <!-- مالی: بدهی/اعتبار — هرگز فقط با رنگ نمایش داده نشوند (متن/آیکون الزامی است) -->
    <color name="ds_debt">@color/status_danger</color>
    <color name="ds_debt_container">@color/status_danger_light</color>
    <color name="ds_debt_on_container">@color/ds_danger_on_container</color>
    <color name="ds_credit">@color/status_success</color>
    <color name="ds_credit_container">@color/status_success_light</color>
    <color name="ds_credit_on_container">@color/ds_success_on_container</color>

    <!-- گروه‌بندی بصری کارت‌های داشبورد (اولویت، نه تزئین) -->
    <color name="ds_group_ops">@color/gold_primary</color>
    <color name="ds_group_tools">#8FA6C9</color>
    <color name="ds_group_finance">@color/status_success</color>
    <color name="ds_group_academic">@color/status_info</color>
    <color name="ds_group_admin">@color/status_warning</color>
    <color name="ds_group_critical">@color/status_danger</color>

    <!-- حالت‌های تعاملی -->
    <color name="ds_ripple">@color/gold_ripple</color>
    <color name="ds_ripple_neutral">#22FFFFFF</color>
    <color name="ds_scrim">#99000000</color>

</resources>
