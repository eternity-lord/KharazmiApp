<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gaj_primary_dark" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/gaj_primary_dark" />
        </shape>
    </item>

    <!-- Focused state -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gaj_primary" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/gaj_accent" />
        </shape>
    </item>

    <!-- Enabled state -->
    <item android:state_enabled="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gaj_primary" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/gaj_primary" />
        </shape>
    </item>

    <!-- Disabled state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/gaj_text_hint" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/gaj_border" />
        </shape>
    </item>
</selector>
