<?xml version="1.0" encoding="utf-8"?>
<!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Kharazmi.Card.Gold"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="18dp"
    app:strokeColor="@color/status_danger"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_normal"
        android:layoutDirection="rtl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvLiveClassTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="ریاضی (کد: 100001)"
                android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLivePulse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 زنده"
                android:textStyle="bold"
                android:textColor="@color/status_danger" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLiveTeacher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👨‍🏫 معلم: علی مرادی"
            android:textAppearance="@style/TextAppearance.Kharazmi.Body"
            android:textColor="@color/text_primary"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvLiveElapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱ ۱۲ دقیقه گذشته"
            android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
            android:textColor="@color/status_danger"
            android:fontFeatureSettings="tnum"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_small">

            <TextView
                android:id="@+id/tvLivePresent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 حاضر: 3"
                android:textStyle="bold"
                android:textColor="@color/status_success" />

            <Space android:layout_width="16dp" android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvLiveAbsent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 غایب: 1"
                android:textStyle="bold"
                android:textColor="@color/status_danger" />

            <Space android:layout_width="16dp" android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvLiveUndetermined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚪ مشخص نشده: 0"
                android:textStyle="bold"
                android:textColor="@color/status_warning" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
