<?xml version="1.0" encoding="utf-8"?>
<!-- DESIGN SYSTEM: سرصفحه داشبورد — گرادیان آرام تیره + خط موی طلایی در پایین -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/ds_bg_surface"
                android:endColor="@color/ds_bg_base"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:gravity="bottom"
        android:height="@dimen/stroke_hairline">
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_accent" />
        </shape>
    </item>
</layer-list>
