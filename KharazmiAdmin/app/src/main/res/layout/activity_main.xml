<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gold_bg_base">

        <!-- Modern Header Section with Primary Accent Colors -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="4dp"
            android:background="@android:color/transparent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/gold_primary"
                android:orientation="vertical"
                android:padding="@dimen/spacing_normal">

                <!-- Dynamic Main Title -->
                <TextView
                    android:id="@+id/tvHeaderMainTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="آموزشگاه علمی آزاد خوارزمی"
                    android:textColor="?attr/colorOnPrimary"
                    android:textAppearance="@style/TextAppearance.Kharazmi.PageTitle"
                    android:gravity="center"
                    android:layout_marginBottom="@dimen/spacing_normal" />

                <!-- Multi-part Subheader row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Right: Shamsi date -->
                    <TextView
                        android:id="@+id/tvHeaderShamsiDate"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="شنبه، ۱۷ مرداد"
                        android:textColor="?attr/colorOnPrimary"
                        android:alpha="0.8"
                        android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                        android:fontFeatureSettings="tnum"
                        android:gravity="start" />

                    <!-- Center: Icon -->
                    <ImageView
                        android:id="@+id/imgHeaderDashboardIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_group"
                        app:tint="?attr/colorOnPrimary" />

                    <!-- Left: Live Clock -->
                    <TextView
                        android:id="@+id/tvHeaderLiveClock"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="16:30"
                        android:textColor="?attr/colorOnPrimary"
                        android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                        android:fontFeatureSettings="tnum"
                        android:textStyle="bold"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- وضعیت امروز: داده لحظه‌ای با کش کوتاه‌مدت -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTodaySummary"
            style="@style/Widget.Kharazmi.Card.Gold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="3dp"
            app:layout_constraintTop_toBottomOf="@id/appBarLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_normal"
                android:paddingVertical="@dimen/spacing_small">

                <TextView
                    android:id="@+id/tvTodaySummaryTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="وضعیت امروز  ↻"
                    android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                    android:textColor="@color/gold_primary"
                    android:clickable="true"
                    android:focusable="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTodayClassesValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                            android:textColor="@color/gold_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="کلاس امروز"
                            android:textAppearance="@style/TextAppearance.Kharazmi.Caption" />

                        <TextView
                            android:id="@+id/tvTodayClassesSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="— شروع‌شده"
                            android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                            android:textColor="@color/status_success" />
                    </LinearLayout>

                    <View
                        android:layout_width="0.5dp"
                        android:layout_height="38dp"
                        android:background="@color/gold_border_subtle" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.25"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTodayPaymentsValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="—"
                            android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                            android:textColor="@color/gold_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="پرداخت امروز (تومان)"
                            android:textAppearance="@style/TextAppearance.Kharazmi.Caption" />
                    </LinearLayout>

                    <View
                        android:layout_width="0.5dp"
                        android:layout_height="38dp"
                        android:background="@color/gold_border_subtle" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTodayEnrollmentsValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                            android:textColor="@color/gold_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ثبت‌نام امروز"
                            android:textAppearance="@style/TextAppearance.Kharazmi.Caption" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/layoutLateClassAlert"
                    style="@style/Widget.Kharazmi.Card.Gold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="0dp"
                    android:layout_marginTop="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/gold_bg_elevated_2"
                    app:strokeColor="@color/status_warning"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/spacing_small"
                        android:paddingVertical="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚠️"
                            android:textAppearance="@style/TextAppearance.Kharazmi.Body" />

                        <TextView
                            android:id="@+id/tvLateClassAlert"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="6dp"
                            android:layout_weight="1"
                            android:text="کلاس دیرشروع"
                            android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                            android:textColor="@color/status_warning"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="‹"
                            android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                            android:textColor="@color/status_warning" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- هشدارهای مالی هوشمند؛ فقط برای admin از کد قابل‌نمایش می‌شود -->
                <LinearLayout
                    android:id="@+id/layoutSmartFinancialAlerts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="هشدارهای مالی هوشمند"
                        android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                        android:textColor="@color/status_warning"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/layoutInstallmentAlerts"
                        style="@style/Widget.Kharazmi.Card.Gold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="0dp"
                        android:layout_marginTop="4dp"
                        app:cardBackgroundColor="@color/gold_bg_elevated_2"
                        app:strokeColor="@color/status_warning"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/spacing_small"
                            android:paddingVertical="4dp">

                            <TextView
                                android:id="@+id/tvInstallmentAlertSummary"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="اقساط سررسیدشده"
                                android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                                android:textColor="@color/status_warning"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnInstallmentAlerts"
                                style="@style/Widget.Kharazmi.Button.Gold.Outline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="جزئیات"
                                android:textColor="@color/status_warning"
                                app:strokeColor="@color/status_warning" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/layoutTeacherSettlementAlerts"
                        style="@style/Widget.Kharazmi.Card.Gold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="0dp"
                        android:layout_marginTop="4dp"
                        app:cardBackgroundColor="@color/gold_bg_elevated_2"
                        app:strokeColor="@color/status_warning"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/spacing_small"
                            android:paddingVertical="4dp">

                            <TextView
                                android:id="@+id/tvTeacherSettlementAlertSummary"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="تسویه‌های معوق معلمان"
                                android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                                android:textColor="@color/status_warning"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTeacherSettlementAlerts"
                                style="@style/Widget.Kharazmi.Button.Gold.Outline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="جزئیات"
                                android:textColor="@color/status_warning"
                                app:strokeColor="@color/status_warning" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Balanced dashboard grid with standard cards -->
        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/dashboardGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:padding="6dp"
            app:alignmentMode="alignMargins"
            app:columnCount="3"
            app:columnOrderPreserved="false"
            app:layout_constraintTop_toBottomOf="@id/cardTodaySummary"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:ignore="MissingClass">

            <!-- ۱. پیشخوان -->
            <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/menu_1_dashboard"
                style="@style/Widget.Kharazmi.Card.Gold"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_columnWeight="1"
                app:layout_rowWeight="1"
                android:layout_margin="3dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_group"
                        app:tint="@color/gold_primary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="پیشخوان"
                        android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ۲. ثبت‌نام -->
            <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/menu_2_register"
                style="@style/Widget.Kharazmi.Card.Gold"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_columnWeight="1"
                app:layout_rowWeight="1"
                android:layout_margin="3dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_add_24"
                        app:tint="@color/gold_primary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ثبت‌نام سریع"
                        android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ۳. لیست دانش‌آموزان -->
            <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/menu_3_students"
                style="@style/Widget.Kharazmi.Card.Gold"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_columnWeight="1"
                app:layout_rowWeight="1"
                android:layout_margin="3dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_search_24"
                        app:tint="@color/gold_primary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="دانش‌آموزان"
                        android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ۴. لیست معلمان -->
            <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/menu_4_teachers"
                style="@style/Widget.Kharazmi.Card.Gold"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_columnWeight="1"
                app:layout_rowWeight="1"
                android:layout_margin="3dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_group"
                        app:tint="@color/gold_primary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="لیست مربیان"
                        android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ۵. مدیریت -->
            <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/menu_5_management"
                style="@style/Widget.Kharazmi.Card.Gold"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_columnWeight="1"
                app:layout_rowWeight="1"
                android:layout_margin="3dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@android:drawable/ic_menu_manage"
                        app:tint="@color/gold_primary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="بخش مدیریت"
                        android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ۶. گزارش‌گیری -->
            <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/menu_6_reports"
                style="@style/Widget.Kharazmi.Card.Gold"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_columnWeight="1"
                app:layout_rowWeight="1"
                android:layout_margin="3dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_history_24"
                        app:tint="@color/gold_primary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="گزارشات مالی"
                        android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ۷. پیامک -->
            <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/menu_7_sms"
                style="@style/Widget.Kharazmi.Card.Gold"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_columnWeight="1"
                app:layout_rowWeight="1"
                android:layout_margin="3dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_history_24"
                        app:tint="@color/gold_primary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="سامانه پیامک"
                        android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ۸. تنظیمات -->
            <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/menu_8_settings"
                style="@style/Widget.Kharazmi.Card.Gold"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_columnWeight="1"
                app:layout_rowWeight="1"
                android:layout_margin="3dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_refresh_24"
                        app:tint="@color/gold_primary"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="تنظیمات مرکزی"
                        android:textAppearance="@style/TextAppearance.Kharazmi.Caption"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ۹. ثبت حواله سریع -->
            <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/menu_9_quick_invoice"
                style="@style/Widget.Kharazmi.Card.Gold"
                android:layout_width="0dp"
                android:layout_height="0dp"
