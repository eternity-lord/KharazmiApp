<?xml version="1.0" encoding="utf-8"?>
<!-- ====================================================================================
     PHASE 2 — activity_student_profile (پروفایل دانش‌آموز: مشخصات، مالی، اقساط، ارتباطات، تایم‌لاین)
     شناسه‌های حفظ‌شده (StudentProfileActivity.kt):
       imgProfile / tvProfileName / tvProfilePhone / tabLayoutProfile / switchSuspend /
       llStudentStandardContainer / llStudentCommunicationContainer / rvStudentCommunicationHistory /
       tvStudentCommunicationEmpty / llStudentTimelineContainer / rvStudentTimeline /
       tvStudentTimelineEmpty / tvTotalDebt / tvDebtTeacher / tvDebtInstitute / btnIssueInvoice /
       cardContent / tvContent / cardInstallments / rvInstallments / tvInstallmentsEmpty /
       btnAddInstallment / cardFinancialStatus / btnDeleteStudent / btnSendPortalLink / fabEditProfile
     وابستگی مهم: ExamActivity همین چیدمان را به‌صورت دیالوگ inflate می‌کند و به این‌ها تکیه دارد:
       tabLayoutProfile / btnIssueInvoice / btnSendPortalLink / btnDeleteStudent / fabEditProfile (مخفی می‌کند)
       cardFinancialStatus (به‌عنوان دکمه دانلود PDF کلیک‌پذیر) / tvTotalDebt / tvContent /
       tvDebtTeacher / tvDebtInstitute / tvProfileName / tvProfilePhone
     بنابراین ترتیب بخش‌ها و نوع (Class) این ویوها تغییر نکرده است.
     ==================================================================================== -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg_base"
    android:layoutDirection="rtl">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ds_header"
        app:elevation="@dimen/elevation_none">

        <!-- ==================== سرصفحه دانش‌آموز ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="@dimen/spacing_normal"
            android:paddingEnd="@dimen/spacing_normal"
            android:paddingTop="@dimen/spacing_snug"
            android:paddingBottom="@dimen/spacing_snug">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="96dp"
                android:layout_height="96dp"
                app:cardCornerRadius="48dp"
                app:cardElevation="@dimen/elevation_card"
                app:cardBackgroundColor="@color/ds_bg_surface_2"
                app:strokeColor="@color/ds_accent"
                app:strokeWidth="@dimen/stroke_emphasis">

                <ImageView
                    android:id="@+id/imgProfile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@android:drawable/sym_def_app_icon"
                    android:scaleType="centerInside"
                    android:padding="@dimen/spacing_snug"
                    android:contentDescription="@string/ds_profile_avatar_desc"
                    android:background="@drawable/bg_ds_ripple_borderless"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:gravity="center"
                android:text="@string/ds_value_placeholder"
                android:textAppearance="@style/TextAppearance.Kharazmi.DS.PageTitle"
                android:maxLines="2"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvProfilePhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2xs"
                android:gravity="center"
                android:text="@string/ds_value_placeholder"
                android:textAppearance="@style/TextAppearance.Kharazmi.DS.Caption"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <!-- تب‌ها: مشخصات / مالی و شهریه / کارنامه / اقساط / ارتباطات / تایم‌لاین -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ds_bg_surface_2"
            app:tabMode="scrollable"
            app:tabGravity="fill"
            app:tabSelectedTextColor="@color/ds_accent"
            app:tabTextColor="@color/ds_text_secondary"
            app:tabIndicatorColor="@color/ds_accent"
            app:tabIndicatorHeight="@dimen/spacing_2xs"
            app:tabTextAppearance="@style/TextAppearance.Kharazmi.DS.Label">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ds_profile_tab_info"/>

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ds_profile_tab_finance"/>

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ds_profile_tab_grades"/>

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ds_profile_tab_installments"/>

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ds_profile_tab_comm"/>

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ds_profile_tab_timeline"/>
        </com.google.android.material.tabs.TabLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        android:paddingStart="@dimen/spacing_normal"
        android:paddingEnd="@dimen/spacing_normal"
        android:paddingTop="@dimen/spacing_normal"
        android:paddingBottom="@dimen/spacing_normal">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ==================== تب‌های عادی (مشخصات/مالی/کارنامه/اقساط) ==================== -->
            <LinearLayout
                android:id="@+id/llStudentStandardContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ========== خلاصه وضعیت حساب ========== -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFinancialStatus"
                    style="@style/Widget.Kharazmi.DS.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/min_touch_target"
                    android:layout_marginBottom="@dimen/spacing_normal"
                    app:rippleColor="@color/ds_ripple">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_normal">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="@dimen/icon_medium"
                                android:layout_height="@dimen/icon_medium"
                                android:src="@drawable/ic_ds_wallet_24"
                                android:importantForAccessibility="no"
                                app:tint="@color/ds_accent"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/spacing_snug"
                                android:text="@string/ds_profile_finance_title"
                                android:textAppearance="@style/TextAppearance.Kharazmi.DS.SectionTitle"/>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/stroke_hairline"
                            android:layout_marginTop="@dimen/spacing_snug"
                            android:layout_marginBottom="@dimen/spacing_snug"
                            android:background="@color/ds_border"/>

                        <!-- وضعیت کلی (بدهی/تسویه/اعتبار) — متن و رنگ آن از سمت کد ست می‌شود -->
                        <TextView
                            android:id="@+id/tvTotalDebt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/min_touch_target"
                            android:gravity="center_vertical"
                            android:text="@string/ds_value_placeholder"
                            android:textAppearance="@style/TextAppearance.Kharazmi.DS.KpiValue"
                            android:textColor="@color/ds_text_primary"
                            android:fontFeatureSettings="tnum"/>

                        <!-- سهم معلم -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/min_touch_target"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="@dimen/icon_small"
                                android:layout_height="@dimen/icon_small"
                                android:src="@drawable/ic_ds_wallet_24"
                                android:importantForAccessibility="no"
                                app:tint="@color/ds_warning"/>

                            <TextView
                                android:id="@+id/tvDebtTeacher"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/spacing_xs"
                                android:text="@string/ds_value_placeholder"
                                android:textAppearance="@style/TextAppearance.Kharazmi.DS.Body"
                                android:fontFeatureSettings="tnum"/>
                        </LinearLayout>

                        <!-- سهم آموزشگاه -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/min_touch_target"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="@dimen/icon_small"
                                android:layout_height="@dimen/icon_small"
                                android:src="@drawable/ic_ds_wallet_24"
                                android:importantForAccessibility="no"
                                app:tint="@color/ds_info"/>

                            <TextView
                                android:id="@+id/tvDebtInstitute"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/spacing_xs"
                                android:text="@string/ds_value_placeholder"
                                android:textAppearance="@style/TextAppearance.Kharazmi.DS.Body"
                                android:fontFeatureSettings="tnum"/>
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:text="@string/ds_profile_finance_note"
                            android:textAppearance="@style/TextAppearance.Kharazmi.DS.Caption"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ========== CTA اصلی: صدور فیش ========== -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIssueInvoice"
                    style="@style/Widget.Kharazmi.DS.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/min_touch_target"
                    android:layout_marginBottom="@dimen/spacing_normal"
                    android:minHeight="@dimen/min_touch_target"
                    android:text="@string/ds_profile_issue_invoice"
                    app:icon="@drawable/ic_ds_receipt_24"
                    app:iconSize="@dimen/icon_medium"
                    app:iconGravity="textStart"/>

                <!-- ========== محتوای متنی تب‌ها (مشخصات / مالی / کارنامه) ========== -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardContent"
                    style="@style/Widget.Kharazmi.DS.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_normal">

                    <TextView
                        android:id="@+id/tvContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/spacing_normal"
                        android:text="@string/ds_profile_content_loading"
                        android:textAppearance="@style/TextAppearance.Kharazmi.DS.Body"
                        android:lineSpacingExtra="@dimen/spacing_xs"/>
                </com.google.android.material.card.MaterialCardView>

                <!-- ========== اقساط (RecyclerView + دکمه افزودن قسط) ========== -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardInstallments"
                    style="@style/Widget.Kharazmi.DS.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_normal"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_normal">

                        <TextView
                            style="@style/Widget.Kharazmi.DS.SectionHeader"
                            android:text="@string/ds_profile_installments_header"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddInstallment"
                            style="@style/Widget.Kharazmi.DS.Button.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/min_touch_target"
                            android:minHeight="@dimen/min_touch_target"
                            android:text="@string/installment_add_btn"
                            android:textSize="@dimen/font_size_label"
                            app:icon="@drawable/ic_add_24"
                            app:iconSize="@dimen/icon_medium"
                            app:iconGravity="textStart"
                            app:iconTint="@color/ds_accent"/>

                        <TextView
                            android:id="@+id/tvInstallmentsEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_snug"
                            android:gravity="center"
                            android:padding="@dimen/spacing_normal"
                            android:text="@string/installment_no_installments"
                            android:textAppearance="@style/TextAppearance.Kharazmi.DS.Body"
                            android:textColor="@color/ds_text_secondary"
                            android:visibility="gone"/>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvInstallments"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_snug"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ========== تعلیق دانش‌آموز ========== -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Kharazmi.DS.Card.Status.Warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_normal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_normal">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchSuspend"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/min_touch_target"
                            android:text="@string/ds_profile_suspend_title"
                            android:textAppearance="@style/TextAppearance.Kharazmi.DS.SectionTitle"
                            android:textColor="@color/ds_warning_on_container"
                            app:showText="false"
                            android:textOn=""
                            android:textOff=""
                            app:thumbTint="@color/ds_switch_thumb"
                            app:trackTint="@color/ds_switch_track"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:text="@string/ds_profile_suspend_note"
                            android:textAppearance="@style/TextAppearance.Kharazmi.DS.Caption"
                            android:textColor="@color/ds_warning_on_container"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ========== اکشن‌های ثانویه ========== -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSendPortalLink"
                    style="@style/Widget.Kharazmi.DS.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/min_touch_target"
                    android:layout_marginBottom="@dimen/spacing_snug"
                    android:minHeight="@dimen/min_touch_target"
                    android:text="@string/ds_profile_portal"
                    android:textColor="@color/ds_info"
                    app:icon="@drawable/ic_group"
                    app:iconSize="@dimen/icon_medium"
                    app:iconGravity="textStart"
                    app:iconTint="@color/ds_info"
                    app:strokeColor="@color/ds_info"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteStudent"
                    style="@style/Widget.Kharazmi.DS.Button.Danger"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/min_touch_target"
                    android:layout_marginBottom="@dimen/spacing_large"
                    android:minHeight="@dimen/min_touch_target"
                    android:text="@string/ds_profile_delete"
                    app:icon="@drawable/ic_ds_delete_24"
                    app:iconSize="@dimen/icon_medium"
                    app:iconGravity="textStart"
                    app:iconTint="@color/ds_danger_on_container"/>

                <!-- فضای امن برای FAB -->
                <android.widget.Space
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/spacing_xxlarge"/>
            </LinearLayout>

            <!-- ==================== تب ارتباطات ==================== -->
            <LinearLayout
                android:id="@+id/llStudentCommunicationContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Widget.Kharazmi.DS.SectionHeader"
                    android:text="@string/ds_profile_comm_header"/>

                <TextView
                    android:id="@+id/tvStudentCommunicationEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="@dimen/spacing_large"
                    android:text="@string/profile_comm_loading"
                    android:textAppearance="@style/TextAppearance.Kharazmi.DS.Body"
                    android:textColor="@color/ds_text_secondary"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvStudentCommunicationHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingBottom="@dimen/spacing_xxlarge"/>
            </LinearLayout>

            <!-- ==================== تب تایم‌لاین ==================== -->
            <LinearLayout
                android:id="@+id/llStudentTimelineContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Widget.Kharazmi.DS.SectionHeader"
                    android:text="@string/ds_profile_timeline_header"/>

                <TextView
                    android:id="@+id/tvStudentTimelineEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="@dimen/spacing_large"
                    android:text="@string/timeline_loading"
                    android:textAppearance="@style/TextAppearance.Kharazmi.DS.Body"
                    android:textColor="@color/ds_text_secondary"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvStudentTimeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingBottom="@dimen/spacing_xxlarge"/>
            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ویرایش پروفایل -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabEditProfile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/spacing_large"
        android:src="@drawable/ic_ds_edit_24"
        android:contentDescription="@string/ds_profile_edit_desc"
        app:backgroundTint="@color/ds_accent"
        app:tint="@color/ds_on_accent"
        app:elevation="@dimen/elevation_button"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
