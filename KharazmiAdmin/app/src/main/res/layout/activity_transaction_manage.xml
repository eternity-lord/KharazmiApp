<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gold_bg_base"
    android:layoutDirection="rtl">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gold_primary"
        app:elevation="@dimen/elevation_appbar"
    >
        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">
            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مدیریت حواله‌ها"
                android:textColor="?attr/colorOnPrimary"
                android:textAppearance="@style/TextAppearance.Kharazmi.PageTitle"/>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- کادر مخفی و بی‌استفاده صرفاً جهت عدم ارور نال پوینتر کد اکتیویتی -->
    <View
        android:id="@+id/cardReportFilter"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"/>

    <!-- Action panel: Outlined telegram style pill buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_normal"
        android:layout_marginTop="@dimen/spacing_normal"
        android:layout_marginBottom="@dimen/spacing_small">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportExcel"
            style="@style/Widget.Kharazmi.Button.Gold.Outline"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="خروجی Excel"
            android:layout_marginEnd="6dp"
            app:icon="@drawable/ic_save_24"
            app:iconTint="@color/gold_primary"
            app:iconSize="18dp"
            app:iconGravity="textStart"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportPdf"
            style="@style/Widget.Kharazmi.Button.Gold.Outline"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="چاپ PDF"
            android:layout_marginStart="6dp"
            app:icon="@drawable/ic_print"
            app:iconTint="@color/gold_primary"
            app:iconSize="18dp"
            app:iconGravity="textStart"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReport"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/spacing_normal"
        android:paddingTop="@dimen/spacing_small"
        android:clipToPadding="false"
        android:layoutAnimation="@anim/layout_animation_fall_down"/>

    <!-- Bottom summary bar: Floating aesthetic card for professional accounting feel -->
    <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Kharazmi.Card.Gold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_normal"
        app:cardBackgroundColor="@color/gold_primary"
        app:cardElevation="6dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_normal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="جمع کل تراکنش‌ها:"
                android:textColor="?attr/colorOnPrimary"
                android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tvTotalSum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 تومان"
                android:textColor="?attr/colorOnPrimary"
                android:textAppearance="@style/TextAppearance.Kharazmi.PageTitle"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
