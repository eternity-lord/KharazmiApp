<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gold_bg_base"
    android:layoutDirection="rtl">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gold_primary"
        app:elevation="@dimen/elevation_appbar"
    >
        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">
            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="بررسی کلاس جهت تایید"
                android:textColor="?attr/colorOnPrimary"
                android:textAppearance="@style/TextAppearance.Kharazmi.PageTitle"/>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_normal">

            <!-- Financial Analysis Card (High Contrast Accounting / Modern Balance) -->
            <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Kharazmi.Card.Gold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_normal"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/gold_primary"
                app:strokeWidth="1.5dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_normal">

                    <TextView
                        android:text="تحلیل مالی کلاس (پیش‌بینی)"
                        android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                        android:textColor="@color/gold_primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/gold_border_subtle" android:layout_marginTop="@dimen/spacing_small" android:layout_marginBottom="@dimen/spacing_small"/>

                    <!-- Student count row -->
                    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="4dp">
                        <TextView android:text="تعداد دانش‌آموز:" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Kharazmi.Body" android:textColor="@color/text_primary"/>
                        <TextView android:id="@+id/tvStudentCount" android:text="0 نفر" android:textAppearance="@style/TextAppearance.Kharazmi.Body" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:fontFeatureSettings="tnum"/>
                    </LinearLayout>

                    <!-- Teacher ask price row -->
                    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="4dp">
                        <TextView android:text="درخواستی معلم (هر جلسه):" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Kharazmi.Body" android:textColor="@color/text_primary"/>
                        <TextView android:id="@+id/tvTeacherAsk" android:text="0" android:textAppearance="@style/TextAppearance.Kharazmi.Body" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:fontFeatureSettings="tnum"/>
                    </LinearLayout>

                    <!-- Institute share row -->
                    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="4dp">
                        <TextView android:text="سهم آموزشگاه (طبق تعرفه):" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Kharazmi.Body" android:textColor="@color/text_primary"/>
                        <TextView android:id="@+id/tvInstShare" android:text="0" android:textAppearance="@style/TextAppearance.Kharazmi.Body" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:fontFeatureSettings="tnum"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/gold_border_subtle" android:layout_marginTop="@dimen/spacing_small" android:layout_marginBottom="@dimen/spacing_small"/>

                    <!-- Final cost row -->
                    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="4dp">
                        <TextView android:text="شهریه هر شاگرد (هر جلسه):" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" android:textStyle="bold" android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle" android:textColor="@color/gold_primary"/>
                        <TextView android:id="@+id/tvFinalCost" android:text="0 تومان" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/gold_primary" android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle" android:textSize="16sp" android:fontFeatureSettings="tnum"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:text="لیست دانش‌آموزان ثبت‌شده توسط معلم"
                android:textAppearance="@style/TextAppearance.Kharazmi.SectionTitle"
                android:textColor="@color/gold_primary"
                android:layout_marginHorizontal="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- List wrapped inside beautiful clean Card -->
            <!-- FIX: Use the declared Widget.Kharazmi.Card.Gold style; remove repeated suffixes. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Kharazmi.Card.Gold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                android:layout_marginBottom="@dimen/spacing_large">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvStudentsPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:padding="@dimen/spacing_small"
                    android:layoutAnimation="@anim/layout_animation_fall_down"/>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Final confirmation action panel: Modern Pill Styled Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_normal"
        android:background="@color/gold_bg_elevated"
        android:elevation="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmClass"
            style="@style/Widget.Kharazmi.Button.Gold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تایید نهایی و فعال‌سازی کلاس"
            app:backgroundTint="@color/gold_primary"
            app:icon="@android:drawable/checkbox_on_background"
            app:iconGravity="textStart"
            app:iconTint="?attr/colorOnPrimary"
            app:elevation="@dimen/elevation_button"
            android:layout_marginHorizontal="@dimen/spacing_small"
            android:layout_marginBottom="@dimen/spacing_small"/>
    </LinearLayout>

</LinearLayout>
